@page "/questions/{Id:guid}"
@using System.Net
@using QnaIntelligence.Application.Questions.Dtos
@inject IHttpClientFactory HttpClientFactory

<PageTitle>@(question?.Title ?? "Question details")</PageTitle>

@if (errorMessage is not null)
{
    <p role="alert">@errorMessage</p>
}
else if (question is null)
{
    <p>Loading question...</p>
}
else
{
    <h1>@question.Title</h1>

    <dl>
        <dt>Technology</dt>
        <dd>@question.Technology</dd>

        <dt>Tag</dt>
        <dd>@question.Tag</dd>

        <dt>Status</dt>
        <dd>@question.Status</dd>

        <dt>Priority</dt>
        <dd>@question.PriorityScore</dd>

        <dt>Content</dt>
        <dd>@question.Content</dd>
    </dl>

    @if (question.Analysis is not null)
    {
        <section aria-labelledby="analysis-heading">
            <h2 id="analysis-heading">AI Analysis</h2>
            <dl>
                <dt>AI Summary</dt>
                <dd>@question.Analysis.Summary</dd>

                <dt>Technologies</dt>
                <dd>@question.Analysis.Technologies</dd>

                <dt>Root Causes</dt>
                <dd>@question.Analysis.RootCauses</dd>

                <dt>Missing Information</dt>
                <dd>@question.Analysis.MissingInformation</dd>

                <dt>Troubleshooting Steps</dt>
                <dd>@question.Analysis.TroubleshootingSteps</dd>

                <dt>Suggested Answer</dt>
                <dd>@question.Analysis.ProposedAnswer</dd>

                <dt>Confidence Score</dt>
                <dd>@question.Analysis.ConfidenceScore.ToString("P0")</dd>
            </dl>
        </section>
    }
    else
    {
        <p>Analysis has not been generated yet.</p>
    }
}

<p><a href="/">Back to questions</a></p>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private GetQuestionDetailsDto? question;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        question = null;
        errorMessage = null;

        try
        {
            using var client = HttpClientFactory.CreateClient("QnaApi");
            using var response = await client.GetAsync($"api/questions/{Id}");

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                errorMessage = "Question not found.";
                return;
            }

            response.EnsureSuccessStatusCode();
            question = await response.Content.ReadFromJsonAsync<GetQuestionDetailsDto>();

            if (question is null)
            {
                errorMessage = "Question details could not be loaded.";
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to load question details. Make sure the API is running.";
        }
    }
}
