@page "/"
@using System.Net.Http
@using System.Net.Http.Json
@using QnaIntelligence.Application.Questions.Dtos
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>Dashboard</PageTitle>

<h1>QnA Intelligence</h1>

<section aria-labelledby="questions-heading">
    <h2 id="questions-heading">Questions</h2>
    <label for="status-filter">Filter by status</label>
    <select id="status-filter" @bind="selectedStatus">
        <option value="All">All</option>
        <option value="New">New</option>
        <option value="Analyzed">Analyzed</option>
        <option value="Answered">Answered</option>
        <option value="Archived">Archived</option>
    </select>
    @if (errorMessage is not null)
    {
        <p role="alert">@errorMessage</p>
    }
    else if (questions is null)
    {
        <p>Loading questions...</p>
    }
    else if (!visibleQuestions.Any())
    {
        <p>No questions found for this status.</p>
    }
    else
    {
        <ul>
            @foreach (var question in visibleQuestions)
            {
                <li>
                    <NavLink href="@($"/questions/{question.Id}")">
                        [@question.PriorityScore] @question.Title
                    </NavLink>
                    @if (question.Source is not null)
                    {
                        <div>Source: @question.Source</div>
                        <div>Imported: @question.ImportedUtc?.ToString("yyyy-MM-dd")</div>
                    }
                    <div>Status: @question.Status</div>
                    <button type="button"
                            @onclick="() => AnalyzeAsync(question.Id)"
                            disabled="@(analyzingQuestionId is not null)">
                        @(analyzingQuestionId == question.Id ? "Analyzing..." : "Analyze")
                    </button>
                </li>
            }
        </ul>
    }
    @if (analysisError is not null)
    {
        <p role="alert">@analysisError</p>
    }
</section>

@code {
    private List<QuestionDto>? questions;
    private string? errorMessage;
    private Guid? analyzingQuestionId;
    private string? analysisError;
    private string selectedStatus = "All";

    private IEnumerable<QuestionDto> visibleQuestions =>
        questions?.Where(question => selectedStatus == "All"
            || string.Equals(question.Status, selectedStatus, StringComparison.OrdinalIgnoreCase))
        ?? [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var client = HttpClientFactory.CreateClient("QnaApi");
            questions = await client.GetFromJsonAsync<List<QuestionDto>>("api/questions") ?? [];
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to load questions. Make sure the API is running.";
        }
    }

    private async Task AnalyzeAsync(Guid questionId)
    {
        analyzingQuestionId = questionId;
        analysisError = null;

        try
        {
            using var client = HttpClientFactory.CreateClient("QnaApi");
            using var response = await client.PostAsync(
                $"api/questions/{questionId}/analyze",
                content: null);
            response.EnsureSuccessStatusCode();
            Navigation.NavigateTo($"/questions/{questionId}");
        }
        catch (HttpRequestException)
        {
            analysisError = "Unable to analyze the question. Make sure the API is running.";
        }
        finally
        {
            analyzingQuestionId = null;
        }
    }
}
